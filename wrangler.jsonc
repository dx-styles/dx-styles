{
  "name": "dx-styles",
  "compatibility_date": "2026-07-03",
  "workers_dev": false,
  "main": "worker.ts",
  "routes": [
    {
      "pattern": "dx-styles.dev/*",
      "zone_name": "dx-styles.dev"
    },
    {
      "pattern": "www.dx-styles.dev/*",
      "zone_name": "dx-styles.dev"
    },
    {
      "pattern": "css-in-js.dev/*",
      "zone_name": "css-in-js.dev"
    },
    {
      "pattern": "www.css-in-js.dev/*",
      "zone_name": "css-in-js.dev"
    }
  ],
  "assets": {
    "directory": "./apps/site/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  }
}
