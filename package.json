{
  "name": "dx-styles",
  "version": "1.3.0",
  "private": false,
  "description": "Compiler-backed CSS-in-TS for zero-runtime, deterministic styling in design systems.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/dx-styles/dx-styles.git"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "dist/**/*.d.ts",
    "dist/**/*.js",
    "dist/**/*.js.map",
    "docs",
    "preeval-runtime.d.ts",
    "processors/*.js",
    "processors/*.d.ts",
    "processors/*.manifest.json",
    "preeval-runtime.js",
    "src/style-handle-contract.js",
    "src/style-handle-contract.d.ts",
    "style-primitives.js",
    "style-primitives.d.ts",
    "README.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "bun": "./dist/runtime/index.js",
      "import": "./dist/runtime/index.js"
    },
    "./preeval-runtime": {
      "types": "./preeval-runtime.d.ts",
      "bun": "./preeval-runtime.js",
      "import": "./preeval-runtime.js",
      "default": "./preeval-runtime.js"
    },
    "./test-support": {
      "types": "./dist/test-support.d.ts",
      "bun": "./dist/test-support.js",
      "import": "./dist/test-support.js",
      "default": "./dist/test-support.js"
    }
  },
  "dependencies": {
    "@wyw-in-js/processor-utils": "^2.3.0",
    "@wyw-in-js/shared": "^2.3.0",
    "@wyw-in-js/transform": "^2.3.0",
    "csstype": "^3.2.3"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.0",
    "@eslint/js": "10.0.1",
    "@happy-dom/global-registrator": "^20.10.6",
    "@testing-library/react": "^16.3.0",
    "@types/bun": "1.3.14",
    "@types/node": "25.9.1",
    "@types/react": "19.2.5",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@wyw-in-js/vite": "^2.3.0",
    "browserslist": "4.28.2",
    "bun-types": "1.3.14",
    "esbuild": "^0.28.1",
    "eslint": "9.39.1",
    "globals": "17.6.0",
    "lightningcss": "1.32.0",
    "marked": "^18.0.6",
    "prettier": "3.8.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "shiki": "^4.3.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.57.2",
    "vite": "8.0.16"
  },
  "scripts": {
    "build": "bun run build:wyw && bun run build:js && bun run build:types && bun run site:build:app",
    "build:js": "bunx vite build --config vite-lib-build.ts",
    "build:types": "bunx tsc -b tsconfig.lib.json",
    "build:wyw": "bunx tsc -p tsconfig.wyw.json",
    "changeset": "bunx changeset",
    "ci": "bun run lint && bun run typecheck && bun run test && bun run build",
    "explain": "bun tooling/explain.ts",
    "lint": "bunx eslint . --config eslint.config.js",
    "release": "bunx changeset publish",
    "site:build": "bun run build:wyw && bun run site:build:app",
    "site:build:app": "bun run --cwd apps/site build",
    "site:dev": "bun run --cwd apps/site dev",
    "site:test": "bun run --cwd apps/site test",
    "test": "bun run build:wyw && bun run build:js && bun run src/__tests__/run.ts && bun run site:test && bun test test/worker.test.ts test/completions.test.ts",
    "typecheck": "bunx tsc -b tsconfig.json",
    "version": "bunx changeset version && bun install --lockfile-only --no-frozen-lockfile"
  },
  "browserslist": [
    "last 2 years",
    "not dead"
  ],
  "wyw-in-js": {
    "tags": {
      "css": "./processors/css.manifest.json",
      "recipe": "./processors/recipe.js",
      "slotRecipe": "./processors/slotRecipe.js",
      "createTheme": "./processors/createTheme.manifest.json",
      "createTokenContract": "./processors/createTokenContract.manifest.json",
      "createVar": "./processors/createVar.manifest.json",
      "keyframes": "./processors/keyframes.manifest.json"
    }
  },
  "sharedLibBuild": {
    "ignoredSourceFiles": [
      "src/style-handle-contract.ts",
      "src/style-handle-contract.js"
    ],
    "ignoredWatchFiles": [
      "src/style-handle-contract.js"
    ],
    "obsoleteArtifactSuffixes": [
      ".cjs",
      ".cjs.map",
      ".d.cts",
      ".d.cts.map",
      ".d.mts",
      ".d.mts.map"
    ]
  }
}
